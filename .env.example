# Copy this file to .env and fill in your own keys. .env is gitignored.

# NVIDIA NIM — primary analysis LLMs + nv-embedqa embeddings (free at build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# Google Gemini — judge LLM + KB summarizer (free at aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here

# Confidence gate: serve iff  top1 >= KB_ABS_FLOOR  AND  (top1 - top2) >= KB_MARGIN_THRESHOLD.
# Margin is the primary signal; the floor is a safety net. Calibrated against the current
# 10-article KB via eval_retrieval.py — re-derive once the KB grows to ~60–80 articles.
KB_MARGIN_THRESHOLD=0.06
KB_ABS_FLOOR=0.39
